<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and later. Nothing leaves the device: not to a cloud backup, and not to
     another phone during a device-to-device transfer.

     A child's progress is not lost by this — it is on the device, and KODO's own sync
     (M13) is the thing a family opts into, deliberately, with a parent present. A silent
     copy into whoever's Google account happens to own the phone is not that. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
